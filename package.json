{
  "name": "dsh-prompt-optimizer-project",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "lint": "oxlint .",
