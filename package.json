    "jsdom": "^30.1.3",
    "lightningcss": "^1.33.0",
    "oxlint": "^1.89.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "use-sync-external-store": "1.6.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "zustand": "~4.5.7"
  }
}
