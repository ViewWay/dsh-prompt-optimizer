{
  "name": "@yimiliya/dsh-client-ui-prompt-optimizer",
  "description": "Browser UI for dsh-prompt-optimizer: trigger, preview panel, queue entries, settings",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViewWay/dsh-prompt-optimizer.git"
  },
  "homepage": "https://github.com/ViewWay/dsh-prompt-optimizer#readme",
  "bugs": "https://github.com/ViewWay/dsh-prompt-optimizer/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/host.d.ts",
      "default": "./lib/host.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-gateway"
      ],
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-api-gateway/client",
        "@deepseek-ai/dsh-client-ui-plugin-manager/client",
        "@deepseek-ai/dsh-client-ui-settings/client"
      ]
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "locale/*.json",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --root ../.."
  },
  "dependencies": {},
  "peerDependencies": {
    "@yimiliya/dsh-api-prompt-optimizer": "workspace:*",
    "@yimiliya/dsh-prompt-optimizer": "workspace:*",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3"
  },
  "devDependencies": {
    "@yimiliya/dsh-api-prompt-optimizer": "workspace:*",
    "@yimiliya/dsh-prompt-optimizer": "workspace:*",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.1-rc.3",
    "@types/react": "^18",
    "@types/node": "^24"
  }
}
