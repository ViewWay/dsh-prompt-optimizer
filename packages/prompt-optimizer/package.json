    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
