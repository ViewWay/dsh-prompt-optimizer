{
  "name": "@yimiliya/dsh-api-prompt-optimizer",
  "description": "Typert Remote controller for dsh-prompt-optimizer",
  "version": "0.3.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViewWay/dsh-prompt-optimizer.git"
  },
  "homepage": "https://github.com/ViewWay/dsh-prompt-optimizer#readme",
  "bugs": "https://github.com/ViewWay/dsh-prompt-optimizer/issues",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/generated/typert.host.d.ts",
      "default": "./lib/generated/typert.host.js"
    },
    "./remote": {
      "types": "./lib/generated/typert.remote-client.d.ts",
      "default": "./lib/generated/typert.remote-client.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src"
  ],
  "scripts": {
    "build": "tsc -b . --force",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@yimiliya/dsh-prompt-optimizer": "workspace:*",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3"
  },
  "devDependencies": {
    "@yimiliya/dsh-prompt-optimizer": "workspace:*",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@types/node": "^24"
  }
}
